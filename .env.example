# Copy to .env and uncomment what you want to change. Every setting has a default;
# the full list is in src/vidsense/config.py (VIDSENSE_<FIELD> and VIDSENSE_LLM_<FIELD>).

# Where processed videos, thumbnails and the Chroma index live
# VIDSENSE_DATA_DIR=data

# Processing
# VIDSENSE_WHISPER_MODEL=large-v3-turbo   # tiny, base, small, medium, large-v3, large-v3-turbo
# VIDSENSE_LANGUAGE=en                    # leave unset to auto-detect
# VIDSENSE_FRAME_FPS=1.0
# VIDSENSE_DTW_SEMANTIC_WEIGHT=0.3        # 0 = align by timestamps only

# Answers
# VIDSENSE_LLM_PROVIDER=ollama            # ollama, openai or none (retrieval only)
# VIDSENSE_LLM_MODEL=deepseek-r1:8b       # e.g. qwen2.5:7b for faster answers, gpt-4o-mini with openai
# VIDSENSE_LLM_OLLAMA_URL=http://localhost:11434

# OpenAI, or any OpenAI-compatible server (DeepSeek API, LM Studio, vLLM, ...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
